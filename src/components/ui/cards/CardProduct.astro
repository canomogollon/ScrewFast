---
// filepath: src/components/ui/cards/CardProduct.astro
interface Item {
  title: string;
  description?: string;
  icon?: string;
}

interface UseCases {
  title: string;
  subTitle?: string;
  items?: Item[];
}

interface Props {
  useCases?: UseCases;
}

const { useCases } = Astro.props;
---

{
  useCases && (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 lg:text-4xl dark:text-neutral-200">
          {useCases.title}
        </h2>
        {useCases.subTitle && (
          <p class="mt-3 text-lg text-slate-700 dark:text-neutral-400">{useCases.subTitle}</p>
        )}
      </div>
      {useCases.items && (
        <div class="grid gap-3 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {useCases.items.map((item: Item) => (
            <div class="group flex flex-col rounded-xl bg-neutral-50 shadow-2xs transition hover:shadow-md focus:shadow-md focus:outline-hidden dark:bg-neutral-700">
              <div class="p-4 md:p-5">
                <div class="flex items-start gap-x-5">
                  {item.icon && (
                    <span
                      class="mt-1 size-5 shrink-0 text-gray-800 dark:text-neutral-200"
                      set:html={item.icon}
                    />
                  )}
                  <div class="grow">
                    <h3 class="font-semibold text-gray-800 group-hover:text-blue-600 dark:text-neutral-200 dark:group-hover:text-neutral-400">
                      {item.title}
                    </h3>
                    {item.description && (
                      <p class="text-sm text-gray-500 dark:text-neutral-500">{item.description}</p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  )
}
