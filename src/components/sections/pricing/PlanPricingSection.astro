---
// Importa este componente en [id].astro y pásale los datos
// const { pricing } = Astro.props.product.data;

const { pricing } = Astro.props; // Asumiendo que le pasas product.data.pricing
---

<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-3xl font-bold tracking-tight text-slate-900 md:leading-tight lg:text-4xl dark:text-neutral-200"
    >
      {pricing.title}
    </h2>
    <p class="mt-3 text-lg text-slate-700 dark:text-neutral-400">
      {pricing.subTitle}
    </p>
  </div>
  <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:items-center">
    {
      pricing.plans.map((plan: any) => (
        <div
          class:list={[
            'flex flex-col rounded-xl border border-gray-50 p-8 text-center dark:border-neutral-700',
            { 'border-2 border-blue-600 dark:border-blue-500': plan.popular },
          ]}
        >
          {plan.popular && (
            <p class="mb-3">
              <span class="inline-flex items-center gap-x-1.5 rounded-full bg-blue-100 px-3 py-1.5 text-xs font-semibold text-blue-800 uppercase dark:bg-blue-600 dark:text-white">
                Más Popular
              </span>
            </p>
          )}

          <h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">{plan.name}</h4>
          <span class="mt-5 text-5xl font-bold text-gray-800 dark:text-neutral-200">
            {plan.price}
          </span>
          <span class="text-sm font-medium text-gray-500 dark:text-neutral-500">{plan.period}</span>
          <p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">{plan.description}</p>

          <ul class="mt-7 space-y-2.5 text-sm">
            {plan.features.map((feature: string) => (
              <li class="flex space-x-2">
                <svg
                  class="mt-0.5 size-4 flex-shrink-0 text-blue-600 dark:text-blue-500"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="text-gray-800 dark:text-neutral-200">{feature}</span>
              </li>
            ))}
          </ul>

          <a
            class:list={[
              'mt-8 inline-flex items-center justify-center gap-x-2 rounded-lg border px-4 py-3 text-sm font-semibold transition',
              plan.popular
                ? 'border-accent-orange bg-accent-orange hover:bg-accent-orange-dark text-white'
                : 'hover:bg-accent-green dark:hover:bg-accent-green-dark border-gray-200 bg-white text-gray-800 shadow-sm disabled:opacity-50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-white',
            ]}
            href={plan.cta.url}
          >
            {plan.cta.text}
          </a>
        </div>
      ))
    }
  </div>
</div>
