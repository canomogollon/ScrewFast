---
import MainLayout from '@/layouts/MainLayout.astro';
import { getEntry, render } from 'astro:content';
import { SITE } from '@data/constants';

// Obtener el contenido FAQ usando Content Collections
const faqContent = await getEntry('faq', 'es/faq-content');
if (!faqContent) {
  return Astro.redirect('/404');
}

// Renderizar el contenido Markdown
const { Content } = await render(faqContent);

const pageTitle = `${faqContent.data.title} | ${SITE.title}`;
const metaDescription =
  faqContent.data.description ||
  'Encuentra respuestas claras y actualizadas a las dudas comunes sobre los servicios y productos de LOGIKIA en inteligencia artificial.';
const ogTitle = `Preguntas Frecuentes | ${SITE.title}`;

// Structured data básico
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/faq`,
  url: `${SITE.url}/faq`,
  name: pageTitle,
  description: metaDescription,
  inLanguage: 'es-CO',
};
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  {structuredData}
>
  <!-- FAQ Section siguiendo Preline UI pattern -->
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <!-- Title -->
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h1 class="text-2xl font-bold md:text-4xl md:leading-tight dark:text-white">
        {faqContent.data.title}
      </h1>
      <p class="mt-1 text-gray-600 dark:text-neutral-400">
        {metaDescription}
      </p>
    </div>
    <!-- End Title -->

    <div class="mx-auto max-w-2xl">
      <!-- Renderizar directamente el contenido markdown como acordeones de Preline -->
      <div class="hs-accordion-group" id="faq-accordion">
        <!-- El contenido se transformará dinámicamente en acordeones -->
        <article class="prose dark:prose-invert hidden max-w-none" id="faq-content">
          <Content />
        </article>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Script para transformar H2+contenido en acordeones de Preline UI -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.getElementById('faq-content');
    const accordionContainer = document.getElementById('faq-accordion');

    if (!article || !accordionContainer) return;

    // Extraer H2 y contenido siguiente
    const headings = article.querySelectorAll('h2');

    headings.forEach((heading, index) => {
      const isFirst = index === 0;
      const question = heading.textContent?.trim() || '';

      // Buscar contenido hasta el siguiente H2
      let content = '';
      let nextElement = heading.nextElementSibling;

      while (nextElement && nextElement.tagName !== 'H2') {
        content += nextElement.outerHTML;
        nextElement = nextElement.nextElementSibling;
      }

      if (question && content) {
        // Crear estructura de acordeón de Preline UI
        const accordionItem = document.createElement('div');
        accordionItem.className = `hs-accordion ${isFirst ? 'active' : ''} hs-accordion hs-accordion-active:bg-gray-100 rounded-xl p-6 dark:hs-accordion-active:bg-white/10`;
        accordionItem.id = `hs-bordered-heading-${index}`;

        //text-balance text-start font-bold text-neutral-800 outline-hidden transition hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-200 dark:hover:text-neutral-400 dark:focus:outline-hidden md:text-lg

        accordionItem.innerHTML = `
          <button
            class="hs-accordion-toggle group pb-3 inline-flex items-center justify-between gap-x-3 w-full rounded-lg text-balance text-start font-bold text-neutral-800 outline-hidden transition hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-200 dark:hover:text-neutral-400 dark:focus:outline-hidden md:text-lg"
            aria-controls="hs-basic-with-title-and-arrow-stretched-collapse-${index}"
            type="button"
          >
          ${question}
            <svg class="hs-accordion-active:hidden block shrink-0 size-5 text-gray-600 group-hover:text-gray-500 dark:text-neutral-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          <svg class="hs-accordion-active:block hidden shrink-0 size-5 text-gray-600 group-hover:text-gray-500 dark:text-neutral-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
          </button>
          <div
            id="hs-basic-with-title-and-arrow-stretched-collapse-${index}"
            class="hs-accordion-content ${isFirst ? '' : 'hidden'} hs-accordion-content w-full overflow-hidden transition-[height] duration-300"
            role="region" 
            aria-labelledby="hs-basic-with-title-and-arrow-stretched-heading-${index}"
          >
            <div class="prose faq text-pretty text-neutral-600 dark:text-neutral-200">
              ${content}
            </div>
          </div>
        `;
        //text-neutral-500 hs-tab-active:text-neutral-600 dark:text-neutral-400 dark:hs-tab-active:text-neutral-200
        accordionContainer.appendChild(accordionItem);
      }
    });

    // Inicializar Preline UI usando HSAccordion global (ya disponible por MainLayout)
    // Usar timeout para asegurar que Preline esté completamente cargado
    setTimeout(() => {
      if (typeof window.HSAccordion !== 'undefined') {
        window.HSAccordion.autoInit();
      } else {
        // Fallback manual si HSAccordion no está disponible
        console.log('HSAccordion no disponible, usando funcionalidad básica');

        document.querySelectorAll('.hs-accordion-toggle').forEach((toggle) => {
          toggle.addEventListener('click', () => {
            const accordion = toggle.closest('.hs-accordion');
            const content = accordion?.querySelector('.hs-accordion-content');
            const isActive = accordion?.classList.contains('active');

            // Cerrar todos los accordions
            document.querySelectorAll('.hs-accordion').forEach((acc) => {
              acc.classList.remove('active');
              const accContent = acc.querySelector('.hs-accordion-content');
              if (accContent) accContent.classList.add('hidden');
            });

            // Abrir el accordion seleccionado si no estaba activo
            if (!isActive && accordion && content) {
              accordion.classList.add('active');
              content.classList.remove('hidden');
            }
          });
        });
      }
    }, 100);

    // Crear structured data dinámico para SEO
    const faqStructuredData = [];
    headings.forEach((heading, index) => {
      const question = heading.textContent?.trim() || '';
      let answer = '';
      let nextElement = heading.nextElementSibling;

      while (nextElement && nextElement.tagName !== 'H2') {
        answer += nextElement.textContent + ' ';
        nextElement = nextElement.nextElementSibling;
      }

      if (question && answer.trim()) {
        faqStructuredData.push({
          '@type': 'Question',
          '@id': `${window.location.href}#question-${index}`,
          name: question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: answer.trim(),
          },
        });
      }
    });

    // Agregar structured data mejorado
    if (faqStructuredData.length > 0) {
      const script = document.createElement('script');
      script.type = 'application/ld+json';
      script.textContent = JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': window.location.href,
        url: window.location.href,
        mainEntity: faqStructuredData,
      });
      document.head.appendChild(script);
    }
  });
</script>
