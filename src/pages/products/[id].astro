---
import MainLayout from '@/layouts/MainLayout.astro';
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardProduct from '@components/ui/cards/CardProduct.astro';
import PlanPrice from '@components/sections/pricing/PlanPricingSection.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import { gsap } from 'gsap';

// ======================================================
// Static paths and props
// ======================================================
export async function getStaticPaths() {
  const productEntries = await getCollection('products', ({ id }) => id.startsWith('es/'));
  return productEntries.map((product) => {
    const idWithoutLang = product.id.replace(/^es\//, '');
    return {
      params: { id: idWithoutLang },
      props: { product },
    };
  });
}

const { product } = Astro.props;

const pageTitle: string = `${product.data.title} | ${SITE.title}`;
const metaDescription: string = product.data.description;
const ogTitle: string = `${product.data.title} | Agentes Logicos | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    //'@id': `https://logikia.co/products/${product.data.title.toLowerCase().replace(/\s+/g, '-')}`,
    // Usa el 'slug' (parámetro de la URL) en lugar de manipular el título.
    // Es más seguro y siempre coincidirá con la URL real.
    '@id': `https://logikia.co/products/${Astro.params.id}`,
    name: product.data.title,
    description: product.data.description,
    brand: {
      '@type': 'Brand',
      name: 'LOGIKIA',
      slogan: 'Inteligencia Artificial Confiable',
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'Profesionales y empresas colombianas',
    },
    inLanguage: 'es-CO',
  }}
>
  <!-- Overlay inicial para animaciones -->
  <div id="overlay" class="fixed inset-0 bg-slate-200 dark:bg-slate-800"></div>

  <!-- HERO PRINCIPAL -->
  <section
    class="mx-auto flex max-w-[85rem] flex-col-reverse items-center gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:gap-12 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div id="fadeInUp" class="w-full lg:w-1/2">
      <h1 class="mb-4 text-5xl leading-tight font-extrabold text-slate-900 dark:text-neutral-200">
        {product.data.title}
      </h1>
      <p class="mb-6 text-lg leading-relaxed text-slate-700 dark:text-neutral-400">
        {product.data.description}
      </p>
      <PrimaryCTA title="Solicitar demostración personalizada" url="/contacto" />
    </div>

    <div class="flex w-full justify-center lg:w-1/2" id="fadeInMoveRight">
      <Image
        src={product.data.main.imgMain}
        alt={`Ilustración del agente ${product.data.title} en acción`}
        class="w-full max-w-md rounded-xl object-contain"
        format="avif"
        loading="eager"
      />
    </div>
  </section>

  <!---Tarjeta de Casos de Usos -->
  <CardProduct useCases={product.data.useCases} />

  <!-- PESTAÑAS DE INFORMACIÓN -->
  <div class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14">
    <nav
      class="mx-auto grid max-w-6xl gap-y-2 sm:flex sm:gap-x-6 sm:gap-y-0"
      aria-label={`Pestañas de información sobre ${product.data.title}`}
      role="tablist"
    >
      {
        product.data.tabs.map((tab, index) => (
          <ProductTabBtn title={tab.title} id={tab.id} dataTab={tab.dataTab} first={index === 0} />
        ))
      }
    </nav>

    <!-- TAB 1 :: Descripción principal -->
    <div class="mt-12 hidden md:mt-16" id="tabs-with-card-1" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid gap-12 md:grid-cols-2">
          <div class="lg:w-3/4">
            <h2
              class="text-3xl font-bold tracking-tight text-slate-900 md:leading-tight lg:text-4xl dark:text-neutral-200"
            >
              {product.data.longDescription.title}
            </h2>
            <p class="mt-3 text-slate-700 dark:text-neutral-400">
              {product.data.longDescription.subTitle}
            </p>
            <div class="mt-6">
              <PrimaryCTA
                title={product.data.longDescription.btnTitle}
                url={product.data.longDescription.btnURL}
              />
            </div>
          </div>

          <div class="space-y-6 lg:space-y-8">
            {
              product.data.descriptionList.map((list) => (
                <div>
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-neutral-200">
                    {list.title}
                  </h3>
                  <p class="mt-1 text-slate-700 dark:text-neutral-400">{list.subTitle}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2 :: Especificaciones técnicas -->
    <div class="mt-12 hidden md:mt-16" id="tabs-with-card-2" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid w-full gap-x-16 md:grid-cols-2">
          <div class="max-w-md space-y-6">
            {
              product.data.specificationsLeft.map((spec) => (
                <div>
                  <h3 class="font-semibold text-slate-900 dark:text-neutral-200">{spec.title}</h3>
                  <p class="text-slate-700 dark:text-neutral-400">{spec.subTitle}</p>
                </div>
              ))
            }
          </div>

          {
            product.data.specificationsRight ? (
              <div class="mt-8 max-w-md space-y-6 md:mt-0 md:ml-auto">
                {product.data.specificationsRight.map((spec) => (
                  <div>
                    <h3 class="font-semibold text-slate-900 dark:text-neutral-200">{spec.title}</h3>
                    <p class="text-slate-700 dark:text-neutral-400">{spec.subTitle}</p>
                  </div>
                ))}
              </div>
            ) : null
          }
        </div>
      </div>
    </div>

    <!-- TAB 3 :: Imágenes / Proceso -->
    <div class="mt-12 hidden md:mt-16" id="tabs-with-card-3" role="tabpanel">
      <div class="mx-auto mb-16 flex flex-col items-center justify-center gap-6 md:flex-row">
        {
          product.data.blueprints.first && (
            <Image
              src={product.data.blueprints.first}
              class="max-w-sm rounded-xl object-cover shadow-xl"
              alt="Vista previa ilustrativa del producto"
              format="avif"
            />
          )
        }

        {
          product.data.blueprints.second && (
            <Image
              src={product.data.blueprints.second}
              class="max-w-sm rounded-xl object-cover shadow-xl"
              alt="Segunda vista o esquema técnico del producto"
              format="avif"
            />
          )
        }
      </div>
    </div>
  </div>

  <!-- SECCIÓN DE PRECIOS - Solo para productos que tienen pricing -->
  {product.data.pricing && <PlanPrice pricing={product.data.pricing} />}
</MainLayout>

<!-- ======================================================
     ANIMACIONES GSAP
====================================================== -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Animaciones progresivas para secciones clave
  gsap.from('#fadeInUp', {
    scrollTrigger: '#fadeInUp',
    y: 80,
    opacity: 0,
    duration: 1.2,
    ease: 'power2.out',
  });

  gsap.from('#fadeInMoveRight', {
    scrollTrigger: '#fadeInMoveRight',
    x: 200,
    opacity: 0,
    duration: 1.2,
    ease: 'power2.out',
  });

  gsap.to('#overlay', { duration: 1.2, autoAlpha: 0, delay: 0.4 });
</script>

<!-- ======================================================
     SCRIPT DE PESTAÑAS (INTERACTIVIDAD)
====================================================== -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    function setButtonInactive(btn: any, activeButton: any) {
      if (btn !== activeButton) {
        btn.classList.remove(
          'active',
          'bg-neutral-100',
          'hover:border-transparent',
          'dark:bg-white/[.05]',
        );

        const tabId = btn.getAttribute('data-target');
        if (tabId) {
          const contentElement = document.querySelector(tabId);
          if (contentElement) {
            contentElement.classList.add('hidden');
          }
        }

        changeHeadingStyle(
          btn,
          ['text-neutral-800', 'dark:text-neutral-200'],
          ['text-orange-400', 'dark:text-orange-300'],
        );
      }
    }

    function activateButton(button: any) {
      button.classList.add(
        'active',
        'bg-neutral-100',
        ',hover:border-transparent',
        'dark:bg-white/[.05]',
      );

      const tabId = button.getAttribute('data-target');
      if (tabId) {
        const contentElementToShow = document.querySelector(tabId);
        if (contentElementToShow) {
          contentElementToShow.classList.remove('hidden');
        }
      }

      changeHeadingStyle(
        button,
        ['text-orange-400', 'dark:text-orange-300'],
        ['text-neutral-800', 'dark:text-neutral-200'],
      );
    }

    function changeHeadingStyle(button: any, addClasses: any, removeClasses: any) {
      let heading = button.querySelector('span');
      if (heading) {
        heading.classList.remove(...removeClasses);
        heading.classList.add(...addClasses);
      }
    }

    const tabButtons = document.querySelectorAll('[data-target]');

    // Inicializar activando la primera pestaña completamente (no solo el estilo)
    if (tabButtons.length > 0) {
      changeHeadingStyle(tabButtons[0], ['text-orange-400', 'dark:text-orange-300'], []);
      activateButton(tabButtons[0]);
    }

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        tabButtons.forEach((btn) => setButtonInactive(btn, button));
        activateButton(button);
      });
    });
  });
</script>
