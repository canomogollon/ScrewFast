---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';

import progressBuilding from '@images/progress-building.avif';
import personWorking from '@images/person-working.avif';
import underConstruction from '@images/under-construction.avif';
import constructionWorkers from '@images/construction-workers.avif';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Consultoría Estratégica en IA Aplicada',
    subTitle:
      'Acompañamos a tu organización en la integración de agentes inteligentes como SalesMind y LawMind, definiendo estrategias personalizadas, asegurando cumplimiento normativo y optimizando procesos comerciales y legales.',
    single: false,
    imgOne: personWorking,
    imgOneAlt: 'Reunión profesional de consultoría en IA',
    imgTwo: progressBuilding,
    imgTwoAlt: 'Planificación estratégica empresarial',
  },
  {
    isRightSection: false,
    title: 'Desarrollo e Integración Tecnológica',
    subTitle:
      'Implementamos soluciones de inteligencia artificial escalables, integradas en canales y plataformas digitales de tu empresa para maximizar captación, atención y conversión, y asegurar una experiencia única para tus clientes.',
    img: progressBuilding,
    imgAlt: 'Equipo de desarrollo trabajando en código',
    btnExists: true,
    btnTitle: 'Solicitar más información',
    btnURL: '/contact',
  },
  {
    isRightSection: true,
    title: 'Formación y Soporte Continuo',
    subTitle:
      'Capacitamos a tus equipos en el uso de agentes IA para procesos comerciales y legales, además de brindar soporte técnico permanente y actualizaciones que garantizan la efectividad y seguridad de la solución.',
    single: false,
    imgOne: underConstruction,
    imgOneAlt: 'Sesión de formación de personal',
    imgTwo: personWorking,
    imgTwoAlt: 'Soporte técnico en acción',
  },
  {
    isRightSection: false,
    title: 'Análisis y Optimización de Resultados',
    subTitle:
      'Medimos el impacto de los agentes inteligentes en tus operaciones, generando reportes detallados y recomendaciones para mejorar continuamente la eficacia y retorno de inversión (ROI).',
    img: personWorking,
    imgAlt: 'Gráficos representando análisis de datos',
  },
  {
    isRightSection: true,
    title: 'Diseño de Estrategias Personalizadas para Sectores Específicos',
    subTitle:
      'Para sectores inmobiliario, legal y otros ámbitos profesionales, diseñamos soluciones a medida que responden a los retos y regulaciones locales, garantizando máxima relevancia y cumplimiento.',
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: 'Diseño de soluciones a medida',
    imgTwo: progressBuilding,
    imgTwoAlt: 'Cumplimiento regulatorio local en Colombia',
    btnExists: true,
    btnTitle: 'Descubre más',
    btnURL: '/products',
  },
];

const pageTitle = `Servicios | LOGIKIA IA Confiable`;
const metaDescription =
  'LOGIKIA ofrece consultoría, desarrollo, formación y soporte en agentes inteligentes para sectores comerciales y legales en Colombia.';
const ogTitle = 'Servicios especializados en inteligencia artificial | LOGIKIA';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://logikia.co/servicios',
    url: 'https://logikia.co/servicios',
    name: 'Servicios especializados en inteligencia artificial | LOGIKIA',
    description:
      'Consultoría, desarrollo e integración de agentes IA confiables para mejorar tus procesos comerciales y legales en Colombia.',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://logikia.co',
      name: 'LOGIKIA',
      description:
        'LOGIKIA ofrece soluciones inteligentes personalizadas para el mercado colombiano.',
    },
    inLanguage: 'es-CO',
  }}
>
  <MainSection
    title="Unimos experiencia y tecnología para potenciar tu negocio"
    subTitle="En LOGIKIA brindamos consultoría, desarrollo, implementación y soporte continuo en inteligencia artificial para sectores comerciales y legales, con un enfoque ético y orientado a resultados."
    btnExists={true}
    btnTitle="Agenda tu consulta"
    btnURL="/contact"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="Datos que respaldan nuestra excelencia"
    subTitle="El compromiso de LOGIKIA con la calidad y la innovación se refleja en cada proyecto y solución que entregamos."
    mainStatTitle="98%"
    mainStatSubTitle="de satisfacción de nuestros clientes"
    stats={[
      {
        stat: '150+',
        description: 'soluciones IA implementadas',
      },
      {
        stat: '30K+',
        description: 'consultas automáticas atendidas mensualmente',
      },
      {
        stat: '90%',
        description: 'reducción en tiempos de respuesta',
      },
    ]}
  />
</MainLayout>
