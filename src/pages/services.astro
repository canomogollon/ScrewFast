---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
// (OPCIONAL) Importa un componente de Preline si lo tienes, o usa el HTML de abajo
// import IconBlocks from '@components/sections/IconBlocks.astro';

// Imágenes importadas
import progressBuilding from '@images/progress-building.avif';
import personWorking from '@images/person-working.avif';
import underConstruction from '@images/under-construction.avif';
import constructionWorkers from '@images/construction-workers.avif';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

// ======================================================
// ARTÍCULOS: Contenido optimizado y más directo
// ======================================================
const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Consultoría Estratégica en IA',
    subTitle:
      'Acompañamos a tu organización en la integración de agentes inteligentes como SalesMind y LawMind, definiendo estrategias personalizadas, asegurando cumplimiento normativo y optimizando tus procesos.',
    single: false,
    imgOne: personWorking,
    imgOneAlt: 'Reunión profesional de consultoría en IA',
    imgTwo: progressBuilding,
    imgTwoAlt: 'Planificación estratégica empresarial',
  },
  {
    isRightSection: false,
    title: 'Desarrollo e Integración (Web/WhatsApp)',
    subTitle:
      'Construimos e integramos los agentes IA en tus canales existentes (web, WhatsApp, Telegram). Creamos soluciones escalables que maximizan la captación y conversión de clientes.',
    img: constructionWorkers, // Imagen actualizada
    imgAlt: 'Equipo de desarrollo integrando APIs',
    btnExists: true,
    btnTitle: 'Solicitar más información',
    btnURL: '/contacto',
  },
  {
    isRightSection: true,
    title: 'Formación Ética y Soporte Continuo',
    subTitle:
      'Capacitamos a tus equipos en el uso ético y efectivo de los agentes. Brindamos soporte técnico permanente y actualizaciones de la base de conocimiento para garantizar la precisión.',
    single: false,
    imgOne: underConstruction, // Imagen actualizada
    imgOneAlt: 'Sesión de formación de personal',
    imgTwo: personWorking,
    imgTwoAlt: 'Soporte técnico en acción',
  },
  {
    isRightSection: false,
    title: 'Análisis de Métricas y Optimización ROI',
    subTitle:
      'Medimos el impacto real de la IA en tu operación. Generamos reportes de rendimiento, conversión y ROI, con recomendaciones para la optimización continua.',
    img: progressBuilding, // Reutilizada para gráficas/reportes
    imgAlt: 'Gráficos representando análisis de datos y ROI',
  },
  {
    isRightSection: true,
    title: 'Soluciones Verticales (Legal e Inmobiliario)',
    subTitle:
      'Diseñamos soluciones IA a medida para los retos únicos del sector inmobiliario y legal en Colombia, garantizando máxima relevancia, precisión y cumplimiento regulatorio.',
    single: false,
    imgOne: personWorking,
    imgOneAlt: 'Abogado usando LawMind',
    imgTwo: underConstruction,
    imgTwoAlt: 'Agente inmobiliario usando SalesMind',
    btnExists: true,
    btnTitle: 'Descubre los Productos',
    btnURL: '/products',
  },
];

// ======================================================
// METADATOS: Optimizados para SEO/AEO
// ======================================================
const pageTitle = `Servicios de IA en Colombia | LOGIKIA IA Confiable`;
const metaDescription =
  'Ofrecemos consultoría, desarrollo e integración de agentes IA (SalesMind, LawMind) para optimizar procesos comerciales y legales en Colombia.';
const ogTitle = 'Servicios de Consultoría y Desarrollo de IA | LOGIKIA';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    /* ======================================================
       OPTIMIZACIÓN AEO: 
       Definimos la página Y todos los servicios que ofrece,
       vinculándolos a la organización principal (LOGIKIA).
    ====================================================== */
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://logikia.co/servicios',
    url: 'https://logikia.co/servicios',
    name: 'Servicios de Consultoría y Desarrollo de IA | LOGIKIA',
    description:
      'Ofrecemos consultoría, desarrollo e integración de agentes IA (SalesMind, LawMind) para optimizar procesos comerciales y legales en Colombia.',
    inLanguage: 'es-CO',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://logikia.co',
      name: 'LOGIKIA',
    },
    publisher: {
      '@type': 'Organization',
      '@id': 'https://logikia.co#organization', // ID único para LOGIKIA
      name: 'LOGIKIA',
      url: 'https://logikia.co',
      logo: 'https://logikia.co/images/logo.svg', // Asegúrate que esta ruta es correcta
    },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Servicios de Inteligencia Artificial de LOGIKIA',
      numberOfItems: 5, // Coincide con tu array de 5 servicios
      itemListElement: [
        {
          '@type': 'Service',
          position: 1,
          name: 'Consultoría Estratégica en IA',
          description:
            'Acompañamos en la integración de agentes inteligentes (SalesMind, LawMind) y definimos estrategias personalizadas asegurando cumplimiento normativo.',
          provider: { '@id': 'https://logikia.co#organization' },
        },
        {
          '@type': 'Service',
          position: 2,
          name: 'Desarrollo e Integración (Web/WhatsApp)',
          description:
            'Implementamos soluciones de IA escalables, integradas en canales y plataformas digitales como WhatsApp y sitios web.',
          provider: { '@id': 'https://logikia.co#organization' },
        },
        {
          '@type': 'Service',
          position: 3,
          name: 'Formación Ética y Soporte Continuo',
          description:
            'Capacitamos equipos en el uso de agentes IA y brindamos soporte técnico permanente y actualizaciones de seguridad.',
          provider: { '@id': 'https://logikia.co#organization' },
        },
        {
          '@type': 'Service',
          position: 4,
          name: 'Análisis de Métricas y Optimización ROI',
          description:
            'Medimos el impacto de los agentes inteligentes en tus operaciones, generando reportes de eficacia y retorno de inversión (ROI).',
          provider: { '@id': 'https://logikia.co#organization' },
        },
        {
          '@type': 'Service',
          position: 5,
          name: 'Soluciones Verticales (Legal e Inmobiliario)',
          description:
            'Diseñamos soluciones IA a medida para los retos y regulaciones de los sectores inmobiliario y legal en Colombia.',
          provider: { '@id': 'https://logikia.co#organization' },
        },
      ],
    },
  }}
>
  <MainSection
    title="Servicios de IA para tu Negocio: De la Estrategia al ROI"
    subTitle="Acompañamos a empresas en Colombia a implementar agentes IA confiables (SalesMind, LawMind). Ofrecemos consultoría estratégica, desarrollo a medida, integración y soporte ético enfocado en resultados."
    btnExists={true}
    btnTitle="Agenda tu consulta"
    btnURL="/contacto"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2
        class="text-3xl font-bold tracking-tight text-slate-900 lg:text-4xl dark:text-neutral-200"
      >
        Impacto Operacional Proyectado
      </h2>
      <p class="mt-3 text-lg text-slate-700 dark:text-neutral-400">
        Nuestra metodología se enfoca en entregar un Retorno de Inversión (ROI) tangible y rápido.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div
        class="flex flex-col items-center rounded-xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-neutral-800 dark:bg-neutral-900"
      >
        <svg
          class="size-7 flex-shrink-0 text-slate-900 dark:text-neutral-200"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 11V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6"></path><path
            d="m12 12 4 10 3-3-4-10z"></path></svg
        >
        <h3 class="mt-3 text-lg font-semibold text-slate-700 dark:text-neutral-400">
          60-80% Reducción
        </h3>
        <p class="mt-1 text-slate-700 dark:text-neutral-400">
          En tiempo de gestión manual de consultas iniciales (SalesMind).
        </p>
      </div>

      <div
        class="flex flex-col items-center rounded-xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-neutral-800 dark:bg-neutral-900"
      >
        <svg
          class="size-7 flex-shrink-0 text-slate-900 dark:text-neutral-200"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
          ></path><polyline points="14 2 14 8 20 8"></polyline><path d="m12 15-3-3 3-3"></path><path
            d="m9 12h7"></path></svg
        >
        <h3 class="mt-3 text-lg font-semibold text-slate-700 dark:text-neutral-400">
          Horas a Minutos
        </h3>
        <p class="mt-1 text-slate-700 dark:text-neutral-400">
          Optimización de tareas de 3 horas (investigación/redacción) a minutos (LawMind).
        </p>
      </div>

      <div
        class="flex flex-col items-center rounded-xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-neutral-800 dark:bg-neutral-900"
      >
        <svg
          class="size-7 flex-shrink-0 text-slate-900 dark:text-neutral-200"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="12" x2="12" y1="20" y2="10"></line><line x1="18" x2="18" y1="20" y2="4"
          ></line><line x1="6" x2="6" y1="20" y2="16"></line></svg
        >
        <h3 class="mt-3 text-lg font-semibold text-slate-700 dark:text-neutral-400">
          ROI en 3 Meses
        </h3>
        <p class="mt-1 text-slate-700 dark:text-neutral-400">
          Proyección de retorno de inversión tangible en el primer trimestre de operación.
        </p>
      </div>

      <div
        class="flex flex-col items-center rounded-xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-neutral-800 dark:bg-neutral-900"
      >
        <svg
          class="size-7 flex-shrink-0 text-slate-900 dark:text-neutral-200"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path></svg
        >
        <h3 class="mt-3 text-lg font-semibold text-slate-700 dark:text-neutral-400">
          Cero Alucinaciones
        </h3>
        <p class="mt-1 text-slate-700 dark:text-neutral-400">
          Garantía de IA confiable, ética y con respuestas 100% verificables y auditables.
        </p>
      </div>
    </div>
  </div>
</MainLayout>
