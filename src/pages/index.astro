---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import pricing from '@data/pricing.json';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [];
---

<MainLayout>
  {
    /*
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore ScrewFast on GitHub"
    url="https://github.com/mearashadowfax/ScrewFast"
  />
*/
  }
  <HeroSection
    title=`IA con lógica, precisión y confianza,  <span
        class="text-accent-green dark:text-accent-green-dark">100% colombiana</span>`
    subTitle="Desarrollamos agentes inteligentes para Colombia, legales y comerciales, basados en hechos, no en ficción. Potencie su empresa con datos verificables y cero alucinaciones."
    primaryBtn="Conocer los agentes"
    primaryBtnURL="/products"
    secondaryBtn="Contactar a ventas"
    secondaryBtnURL="/contact"
    withReview={false}
    avatars={avatarSrcs}
    rating={``}
    starCount={0}
    reviews={``}
    src={heroImage}
    alt="LOGIKIA impulsa la transformación digital ética en Colombia. Nuestro agente comercial SalesMind y el asistente legal LawMind operan con precisión y fuentes verificadas, eliminando riesgos."
  />

  <ClientsSection
    title="Aliados que impulsan una IA confiable en colombia"
    subTitle="Colaboramos con líderes del sector público, académico y empresarial para construir un ecosistema de IA ético y preciso. Profesionales en Colombia confían en nuestra tecnología para aumentar su productividad, precisión y credibilidad operativa."
    partners={partnersData}
  />

  <FeaturesGeneral
    title="Una plataforma de IA diseñada para la confianza"
    subTitle="Respuestas verificadas y auditables basadas en fuentes oficiales colombianas."
    src={featureImage}
    alt="Agentes LogikIA interactuando con usuarios en diversos dispositivos."
    {features}
  />

  <FeaturesNavs
    title=`<span class="text-accent-green dark:text-accent-green-dark">Nuestros agentes</span>: Su experto dedicado 24/7.`
    tabs={[
      {
        heading: 'SalesMind',
        content:
          'Un asesor comercial que automatiza la atención al cliente, genera cotizaciones y califica prospectos. Libera a su equipo para que se enfoque en cerrar ventas estratégicas.',
        svg: 'tools',
        src: tools,
        alt: 'Interfaz de usuario del agente comercial SalesMind mostrando interacciones con clientes y generación de cotizaciones',
        first: true,
      },
      {
        heading: 'LawMind',
        content:
          'Un asistente jurídico experto entrenado con el corpus legal colombiano. Entrega respuestas precisas con fuentes normativas para optimizar la investigación y eliminar errores de interpretación.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Interfaz de usuario del asistente legal LawMind mostrando consultas legales y referencias normativas',
        second: true,
      },
      {
        heading: 'Tu Agente Personalizado',
        content:
          '¿Necesitas un agente adaptado a tu industria? Colaboramos contigo para desarrollar soluciones de IA personalizadas que aborden tus desafíos específicos, integrándose perfectamente con tus sistemas existentes.',
        svg: 'house',
        src: construction,
        alt: 'Construccion de Agentes de IA personalizados para diversas industrias',
      },
    ]}
  />

  <PricingSection {pricing} />

  <FAQ title="Preguntas<br />frecuentes" {faqs} />

  <HeroSectionAlt
    title="Agende una Demo Personalizada"
    subTitle="Transforme su forma de trabajar con inteligencia artificial, lógicamente confiable."
    url={`${import.meta.env.BASE_URL}/contacto`}
  />
</MainLayout>
