{
  "mcpServers": {
    "Astro docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.docs.astro.build/mcp"],
      "alwaysAllow": ["search_astro_docs"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.38",
        "--browser=chrome",
        "--headless",
        "--viewport-size=1280,720"
      ],
      "disabled": false,
      "alwaysAllow": [
        "playwright_navigate",
        "playwright_screenshot",
        "playwright_click",
        "playwright_fill",
        "playwright_select",
        "playwright_hover",
        "playwright_evaluate",
        "browser_navigate",
        "browser_click",
        "browser_evaluate",
        "browser_wait_for"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    },
    "git-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.29",
        "https://gitmcp.io/canomogollon/ScrewFast"
      ],
      "alwaysAllow": ["search_ScrewFast_code"]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/inspector",
        "uvx",
        "mcp-server-git",
        "--repository",
        "/home/elkin/devs/astrojs/logikia"
      ]
    }
  }
}
